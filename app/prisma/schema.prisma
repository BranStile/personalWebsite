generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String    @id @default(cuid())
  title       String    @default("Change Me")
  description String    @default("Change Me")    
  skillsUsed String    @default("Change Me")
  demoUrl     String?
  repoUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  photoLink    String    @default("/brandon2025-5.jpg")
  photoAlt    String    @default("Picture of Brandon")
  pageURL    String    @default("/")
  pageID      String    @default("")
  startDate DateTime?
  endDate DateTime?
}

model AboutMe{
  id         String @id @default(cuid())
  resumeLink String @default("/BrandonStileResume.pdf")
  summary    String @default("")
  photoLink  String @default("BrandonStilePhoto")
  photoAlt   String @default("Photo of Brandon")
}

model Experience {
  id          String    @id @default(cuid())
  title       String    @default("Change Me")
  company     String    @default("Change Me")
  startDate   DateTime  @default(now())
  endDate     DateTime?
  description String    @default("Change Me")
  createdAt   DateTime  @default(now())
  photoLink   String    @default("")
  photoAlt    String    @default("") 
  skillsUsed  String    @default("")
  pageURL     String    @default("/")
  pageID      String    @default("")
}

model Skill {
  id          String    @id @default(cuid())
  name        String    @default("Change Me")
  category    String    @default("Change Me")
}
